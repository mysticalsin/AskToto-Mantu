{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mysticalsin/AskToto-Mantu/schema/runtime-trust-root-receipt-v1.json",
  "title": "Métis Sigstore Trust Root Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "verifiedBy", "sourceCommit", "workflowRef", "workflowCommit", "runId", "attempt", "lockSha256", "rootBytes", "rootSha256"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "source": { "const": "https://tuf-repo-cdn.sigstore.dev/targets/trusted_root.json" },
    "verifiedBy": {
      "type": "object", "additionalProperties": false, "required": ["package", "version"],
      "properties": { "package": { "const": "@sigstore/tuf" }, "version": { "const": "5.0.0" } }
    },
    "sourceCommit": { "$ref": "#/$defs/gitSha" },
    "workflowRef": { "type": "string", "minLength": 1, "maxLength": 512 },
    "workflowCommit": { "$ref": "#/$defs/gitSha" },
    "runId": { "type": "string", "pattern": "^[0-9]{1,20}$" },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "lockSha256": { "$ref": "#/$defs/sha256" },
    "rootBytes": { "type": "integer", "minimum": 1, "maximum": 2000000 },
    "rootSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
  }
}
