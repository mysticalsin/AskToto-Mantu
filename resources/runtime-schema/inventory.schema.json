{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mysticalsin/AskToto-Mantu/schema/runtime-inventory-v1.json",
  "title": "Métis Runtime Artifact Inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "componentId",
    "artifactId",
    "target",
    "runtime",
    "source",
    "builder",
    "upstream",
    "files",
    "licenses",
    "entrypoints",
    "models"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "enum": [
        "runtime",
        "model"
      ]
    },
    "componentId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{0,79}$"
    },
    "artifactId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{0,79}$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "arch"
      ],
      "properties": {
        "platform": {
          "enum": [
            "darwin",
            "win32",
            "any"
          ]
        },
        "arch": {
          "enum": [
            "arm64",
            "x64",
            "any"
          ]
        }
      }
    },
    "runtime": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "electronVersion",
            "nodeAbi",
            "napi",
            "chromiumVersion",
            "hostProtocol"
          ],
          "properties": {
            "electronVersion": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "nodeAbi": {
              "type": "string",
              "pattern": "^[0-9]{1,8}$"
            },
            "napi": {
              "type": "string",
              "pattern": "^[0-9]{1,8}$"
            },
            "chromiumVersion": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "hostProtocol": {
              "const": 1
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryUri",
        "commit",
        "workflowPath",
        "workflowCommit",
        "runId",
        "attempt",
        "lockSha256",
        "ref",
        "runnerEnvironment"
      ],
      "properties": {
        "repositoryUri": {
          "const": "https://github.com/mysticalsin/AskToto-Mantu"
        },
        "commit": {
          "$ref": "#/$defs/gitSha"
        },
        "workflowPath": {
          "type": "string",
          "pattern": "^\\.github/workflows/[a-z0-9-]+\\.yml$"
        },
        "workflowCommit": {
          "$ref": "#/$defs/gitSha"
        },
        "runId": {
          "type": "string",
          "pattern": "^[0-9]{1,20}$"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "lockSha256": {
          "$ref": "#/$defs/sha256"
        },
        "ref": {
          "type": "string",
          "pattern": "^refs/(?:heads|pull)/(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._/-]{1,240}$"
        },
        "runnerEnvironment": {
          "const": "github-hosted"
        }
      }
    },
    "builder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeVersion",
        "npmVersion",
        "zlibVersion",
        "packages"
      ],
      "properties": {
        "nodeVersion": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "npmVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "zlibVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "packages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "version"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          }
        }
      }
    },
    "upstream": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "sourceUri",
          "revision",
          "digest"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "sourceUri": {
            "type": "string",
            "pattern": "^https://[^?#]+$"
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "digest": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "algorithm",
              "value"
            ],
            "properties": {
              "algorithm": {
                "enum": [
                  "sha256",
                  "sha512"
                ]
              },
              "value": {
                "type": "string",
                "pattern": "^(?:[a-f0-9]{64}|[a-f0-9]{128})$"
              }
            }
          }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "bytes",
          "sha256",
          "executable"
        ],
        "properties": {
          "path": {
            "$ref": "#/$defs/relativePath"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000000000
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "executable": {
            "type": "boolean"
          }
        }
      }
    },
    "licenses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "package",
          "version",
          "spdx",
          "sourceUri",
          "noticePath",
          "noticeBytes",
          "noticeSha256",
          "sourceReceiptUri"
        ],
        "properties": {
          "package": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "spdx": {
            "type": "string",
            "pattern": "^[A-Za-z0-9.+() -]{1,128}$"
          },
          "sourceUri": {
            "type": "string",
            "pattern": "^https://[^?#]+$"
          },
          "noticePath": {
            "$ref": "#/$defs/relativePath"
          },
          "noticeBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20000000
          },
          "noticeSha256": {
            "$ref": "#/$defs/sha256"
          },
          "sourceReceiptUri": {
            "type": "string",
            "pattern": "^https://[^?#]+$"
          }
        }
      }
    },
    "entrypoints": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 0,
      "maxProperties": 5,
      "properties": {
        "parakeet-host": {
          "$ref": "#/$defs/relativePath"
        },
        "whisper-import-host": {
          "$ref": "#/$defs/relativePath"
        },
        "whisper-renderer-worker": {
          "$ref": "#/$defs/relativePath"
        },
        "speaker-embedding-host": {
          "$ref": "#/$defs/relativePath"
        },
        "llama-server": {
          "$ref": "#/$defs/relativePath"
        }
      }
    },
    "models": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "root",
          "members"
        ],
        "properties": {
          "id": {
            "enum": [
              "asr.parakeet-tdt-0.6b-v3-int8",
              "asr.whisper-base-q8",
              "speaker.embedding",
              "qwen3.5-0.8b",
              "qwen3.5-4b"
            ]
          },
          "root": {
            "$ref": "#/$defs/relativePath"
          },
          "members": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100000,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/relativePath"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "runtime"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "target": {
            "properties": {
              "platform": {
                "enum": [
                  "darwin",
                  "win32"
                ]
              },
              "arch": {
                "enum": [
                  "arm64",
                  "x64"
                ]
              }
            }
          },
          "runtime": {
            "type": "object"
          }
        }
      },
      "else": {
        "properties": {
          "target": {
            "properties": {
              "platform": {
                "const": "any"
              },
              "arch": {
                "const": "any"
              }
            }
          },
          "runtime": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "runtime"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "entrypoints": {
            "minProperties": 1
          },
          "models": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "entrypoints": {
            "maxProperties": 0
          },
          "models": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*(?:^|/)[A-Za-z0-9._@+-]*\\.(?:/|$))(?!.*(?:^|/)(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM](?:[1-9]|[¹²³])|[lL][pP][tT](?:[1-9]|[¹²³]))(?:\\.|/|$))[A-Za-z0-9._@+-]+(?:/[A-Za-z0-9._@+-]+)*$"
    }
  }
}
