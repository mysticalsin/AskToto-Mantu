{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": { "@/*": ["src/renderer/src/*"], "@shared/*": ["src/shared/*"] }
  },
  "include": ["src/renderer/src/**/*", "src/shared/**/*", "src/preload/index.d.ts", "src/preload/speech-pack.ts", "src/preload/cloud-speech.ts", "src/preload/transcript-revision.ts", "src/preload/metrics.ts", "src/preload/voice-actions.ts", "src/preload/command-confirm.ts", "src/preload/task-cards.ts", "src/preload/dictation-memory.ts", "src/preload/feature-apis.ts", "src/preload/session-context.ts", "src/preload/context-grants.ts", "src/preload/screen-marks.ts", "src/preload/task-browser.ts", "src/preload/export-reveal.ts", "src/preload/walkthrough.ts", "src/preload/spoken-replies.ts", "src/preload/artifacts.ts", "src/preload/assistants.ts", "src/preload/user-memory.ts", "src/preload/connector-accounts.ts", "src/preload/quiet.ts", "src/preload/attachments.ts"],
  "exclude": ["**/*.test.ts", "**/*.spec.ts", "**/*.test.tsx", "**/*.spec.tsx"]
}
