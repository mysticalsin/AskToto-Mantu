{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src/local-ai-worker",
    "outDir": "out/local-ai-worker",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "sourceMap": false,
    "noEmitOnError": true
  },
  "include": ["src/local-ai-worker/**/*.mts"],
  "exclude": ["src/local-ai-worker/**/*.test.ts"]
}
