# Bundled ASR model weights — populated by `npm run fetch-models` before packaging.
# The .gitkeep files in each dir ARE tracked so electron-builder extraResources config is valid.
resources/models/**
resources/asr/**
resources/ort/**
!resources/models/.gitkeep
!resources/asr/.gitkeep
!resources/ort/.gitkeep

# Build-time-only local AI supply chain. Metadata/licenses are tracked; weights and staged payloads are not.
resources/local-ai/cache/**
resources/local-ai/payload/**
resources/local-ai/.payload.staging-*/
resources/local-ai/.payload.rollback-*/

# Session QA scratch (never commit — 100M+ Electron userData, one-off test artifacts)
.temp-qa-userdata/
deep-qa-test.mjs
issues_to_fix.md
# Multi-agent handoff scratch (never commit — carries AI-tool session identifiers, not app source)
Relay Baton/
_agent_state/

# Windows packaging output dirs (electron-builder -c.directories.output overrides) — multi-GB, never commit
release-win*/

# Personal/scratch content at repo root — not app source
Video/
/*.png
graphify-out/
docs/superpowers/

# LGPL ffmpeg sidecar binaries: deliberately untracked — CI provisions them from the
# ffmpeg-sidecar-v1 GitHub release (see docs/ENTERPRISE_RELEASE.md). Manifest hashes pin integrity.
resources/ffmpeg/
