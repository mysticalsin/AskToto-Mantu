node_modules/
out/
dist/
release/
# The AppX target builds into its own output dir so it can never inherit release/win-unpacked's
# app-update.yml — a Store package must not carry the auto-updater's config.
release-appx/
*.log
.env
.env.local
.DS_Store

# Cahê pilot's local Kimi API key input for electron-builder.cahe.win.yml's extraResources (never
# commit the real key; scripts/check-cahe-package.mjs only lets the packaged copy through when
# METIS_CAHE_EMBED_KEY=1 is set). The packaged cahe/kimi.json under release/ is already covered by
# the release/ ignore above.
build/cahe-kimi.local.json
build/make-cahe.ps1

# Optional installer-embedded Cloudflare proxy key (main build, every platform — see
# src/main/embedded-cloudflare-key.ts + electron-builder.yml's extraResources + docs/CLOUDFLARE.md).
# Same disclosed-and-scoped pattern as the Cahê key above: never commit the real key; only its own
# labeled "embedded-default" entry in the Worker's METIS_PROXY_KEYS, never the operator's own key.
# Ignore anything real dropped in this dir (key.json when embedding, or key.json.pending-deploy while
# staged locally before the Worker-side label exists) — only .gitkeep is ever meant to be tracked.
build/cloudflare-embed/*
!build/cloudflare-embed/.gitkeep
.vite/
coverage/
*.tsbuildinfo
.claude/

.playwright-mcp/

# Bundled ASR model weights — populated by `npm run fetch-models` before packaging.
# The .gitkeep files in each dir ARE tracked so electron-builder extraResources config is valid.
resources/models/**
resources/asr/**
resources/ort/**
!resources/models/.gitkeep
!resources/asr/.gitkeep
!resources/ort/.gitkeep

# Build-time-only local AI supply chain. Metadata/licenses are tracked; weights and staged payloads are not.
resources/local-ai/cache/**
resources/local-ai/payload/**
resources/local-ai/.payload.staging-*/
resources/local-ai/.payload.rollback-*/

# Session QA scratch (never commit — 100M+ Electron userData, one-off test artifacts)
.temp-qa-userdata/
deep-qa-test.mjs
issues_to_fix.md
# Multi-agent handoff scratch (never commit — carries AI-tool session identifiers, not app source)
Relay Baton/
_agent_state/

# Windows packaging output dirs (electron-builder -c.directories.output overrides) — multi-GB, never commit
release-win*/

# Personal/scratch content at repo root — not app source
Video/
/*.png
graphify-out/
docs/superpowers/

# Official Electron zips staged for the mac build by scripts/provision-electron-dist.mjs, which
# verifies each against Electron's published SHASUMS256.txt before staging. Never committed: ~220 MB
# of upstream binaries, reproducible from the pinned electron version at any time.
resources/electron-dist/

# LGPL FFmpeg sidecar binaries are provisioned by CI, but their reviewed manifest and license are
# tracked here so a mutable GitHub release can never replace both a binary and its trust anchor.
resources/ffmpeg/*
!resources/ffmpeg/manifest.json
!resources/ffmpeg/LICENSE.LGPL-2.1.txt

# Pinned llama.cpp `llama-server` sidecar (Métis Local runtime) — populated by
# `npm run fetch:llama` / scripts/fetch-llama-server.mjs. Archive sha256 pins integrity; no .gitkeep
# needed since check-llama-sidecar.mjs hard-fails every packaging path before electron-builder ever
# reads extraResources if this is missing (same guarantee resources/ffmpeg relies on above).
resources/llama/

# Qwen model payload bundled into every installer. Build scripts fetch and SHA-256 verify these files;
# Git tracks only the directory marker and notices, never the ~764 MB weights themselves.
resources/local-llm/models/
resources/local-llm/**/*.part

# scripts/prove-local-ttft.mjs's download-fallback cache (only populated when neither
# ASKTOTO_PROVE_MODEL_DIR nor an existing userData download is found) — sha256-pinned, never commit.
.cache/

# Rocket-fuel / relay engagement working notes (not app source)
.rocket-fuel/
_relay/

# metis-mac-helper Swift sidecar binary (Vision OCR + frontmost watcher) — compiled from
# native/mac-helper/main.swift by scripts/build-mac-helper.mjs in every mac packaging chain;
# check-mac-helper.mjs hard-fails packaging if it's missing, so the binary never needs committing.
resources/mac-helper/

# Native app build artifacts
native-app/MetisKit/.build/
native-app/**/*.xcodeproj/xcuserdata/

# Packaged-app QA harness scratch output (.forge live E2E runs)
.forge/qa/
.forge/qa-udd-*/
.forge/qa-appdata/
