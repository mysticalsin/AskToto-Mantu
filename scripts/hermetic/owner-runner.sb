;; Strict owner-QA boundary. No allow exception can reopen a protected tree.
(version 1)
(allow default)
;; Link creation is a separate Seatbelt operation, not covered by file-write*.
(deny file-link)
(deny mach-lookup (global-name "com.apple.SecurityServer"))
(deny mach-lookup (global-name "com.apple.securityd"))
(deny mach-lookup (global-name "com.apple.securityd.xpc"))
(deny mach-lookup (global-name "com.apple.securityd.systemkeychain"))
(deny mach-lookup (global-name "com.apple.securityd.aps"))
(deny mach-lookup (global-name "com.apple.securityd.ckks"))
(deny mach-lookup (global-name "com.apple.securityd.general"))
(deny mach-lookup (global-name "com.apple.securityd.sos"))
(deny mach-lookup (global-name "com.apple.security.octagon"))
(deny mach-lookup (global-name "com.apple.security.escrow-update"))
(deny mach-lookup (global-name "com.apple.security.kcsharing"))
(deny file-write*
  (require-not
    (require-any
      (subpath (param "WORKSPACE"))
      (subpath (param "QA_TMP"))
      (literal "/dev/null"))))
(deny file-write* (subpath (param "TRUSTED_CODE")))
(deny file-write-unlink (regex (param "ANCESTORS")))
(if (string=? (param "PHASE") "candidate")
  (begin
    (deny file-read* file-write* (subpath (param "CANARY")))
    (deny file-write* (subpath (param "CONTROL")))))
(deny file-read* file-write*
  (subpath (string-append (param "HOME") "/Library/CloudStorage"))
  (subpath (string-append (param "HOME") "/Library/Keychains"))
  (subpath (string-append (param "HOME") "/.wrangler"))
  (subpath (string-append (param "HOME") "/Library/Preferences/.wrangler"))
  (subpath (string-append (param "HOME") "/Library/Application Support/Metis"))
  (subpath (string-append (param "HOME") "/Library/Application Support/Metis Light"))
  (subpath (string-append (param "HOME") "/Library/Application Support/TotoWhisper"))
  (subpath (string-append (param "HOME") "/Library/Application Support/Métis"))
  (subpath (string-append (param "HOME") "/Library/Application Support/AskToto"))
  (subpath (string-append (param "HOME") "/Library/Application Support/asktoto"))
  (subpath (string-append (param "HOME") "/Library/Application Support/asktoto-dev"))
  (subpath (string-append (param "HOME") "/.ssh"))
  (subpath (string-append (param "HOME") "/.aws"))
  (subpath (string-append (param "HOME") "/.gnupg"))
  (subpath (string-append (param "HOME") "/.config"))
  (subpath (string-append (param "HOME") "/.netrc"))
  (subpath (string-append (param "HOME") "/.claude"))
  (subpath (string-append (param "HOME") "/.codex"))
  (subpath (string-append (param "HOME") "/Documents"))
  (subpath (string-append (param "HOME") "/Desktop"))
  (subpath (string-append (param "HOME") "/Downloads"))
  (subpath (string-append (param "HOME") "/Pictures"))
  (subpath (string-append (param "HOME") "/Movies"))
  (subpath (string-append (param "HOME") "/Music"))
  (subpath (string-append (param "HOME") "/Library/Mail"))
  (subpath (string-append (param "HOME") "/Library/Messages"))
  (subpath (string-append (param "HOME") "/Library/Safari"))
  (subpath (string-append (param "HOME") "/Library/Cookies"))
  (subpath (string-append (param "HOME") "/AI-Brain-build")))
