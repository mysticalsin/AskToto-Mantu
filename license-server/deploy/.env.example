# Copy this file to .env (in this same deploy/ folder) and fill in real values.
# .env is gitignored - it will never be committed.

# The public domain customers' machines will reach this server at.
# Point a DNS A record for this domain at your server's public IP first.
LICENSE_DOMAIN=licenses.yourcompany.com

# The admin credential for /admin/* routes (dashboard + CLI scripts).
# Generate a real one with: openssl rand -hex 24
LICENSE_ADMIN_TOKEN=change-me-to-a-long-random-secret

# Optional: POST license lifecycle events (created/revoked/seat-limit/expiring-soon...)
# to this URL - a Discord webhook works directly (auto-formatted as embeds), or use a
# Slack/Teams relay, n8n, Zapier, or your own endpoint (generic JSON).
# LICENSE_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Optional: sign each delivery (X-AskToto-Signature: sha256=<hex HMAC of the body>).
# LICENSE_WEBHOOK_SECRET=change-me-too

# Optional: enable GET /metrics (Prometheus text format) for uptime monitoring.
# Use a DIFFERENT secret than the admin token - metrics only expose aggregate counts.
# METRICS_TOKEN=change-me-as-well
