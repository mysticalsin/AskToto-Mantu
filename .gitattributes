# Exact upstream license hashes include their original line endings; never let Git rewrite them.
resources/local-ai/licenses/*.txt -text
# This upstream file is intentionally CRLF; Git should treat CR as part of its line ending during whitespace checks.
resources/local-ai/licenses/Qwen3-0.6B-Apache-2.0.txt whitespace=cr-at-eol
# Métis-authored catalog and provenance records stay stable across macOS and Windows checkouts.
resources/local-ai/candidates.json text eol=lf
resources/local-ai/licenses/*.md text eol=lf

# The local-model license was renamed from resources/local-ai/licenses/* to resources/local-llm/*.
# Keep its upstream LF bytes intact so the hash pin in scripts/local-model-assets.mjs verifies on
# Windows checkouts where core.autocrlf would otherwise rewrite it (LF->CRLF) and fail check:local-model.
resources/local-llm/*.txt -text

# Mode skills are hashed LF-only. Pin checkout so Windows CI does not rewrite them.
skills/**/*.md text eol=lf

# Operator Worker sources are fingerprinted/bundled LF-only (build-client.mjs →
# client.generated.ts). Pin checkout so Windows CI (core.autocrlf) does not rewrite them.
# Keep binaries binary — operator/ also ships .png/.woff2 map assets.
operator/**/*.ts text eol=lf
operator/**/*.mjs text eol=lf
operator/**/*.js text eol=lf
operator/**/*.css text eol=lf
operator/**/*.json text eol=lf
operator/**/*.jsonc text eol=lf
operator/**/*.sql text eol=lf
operator/**/*.md text eol=lf
operator/**/*.svg text eol=lf
operator/**/*.png binary
operator/**/*.woff2 binary
