# Copy to .env and fill in. Any key can also be set in-app via Settings → Your AI (stored encrypted).
# AskToto auto-detects the provider from most key prefixes (nvapi-, sk-ant-, sk-or-, gsk_, fw_, tgp_v1_, eyJ…).

# --- LLM providers (set whichever you use; one is enough) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
NVIDIA_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=        # Qwen / Alibaba
MINIMAX_API_KEY=
MOONSHOT_API_KEY=         # Kimi
OPENROUTER_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
MISTRAL_API_KEY=
ASKTOTO_CUSTOM_API_KEY=   # for the "Custom · OpenAI-compatible" provider

# Optional default model overrides (env-sourced, not hardcoded)
ASKTOTO_ANSWER_MODEL=claude-opus-4-8
ASKTOTO_FAST_MODEL=claude-haiku-4-5-20251001
