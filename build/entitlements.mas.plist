<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Required for Mac App Store distribution. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- V8 JIT compilation for Electron. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Native ASR modules may allocate executable memory at runtime. -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- API calls, OAuth flows, Dust, and license checks. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- On-device transcription. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- User-selected transcript and note folders. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <!-- Meeting-app detection through Apple Events where permitted. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
  </dict>
</plist>
